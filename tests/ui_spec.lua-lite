local this = debug.getinfo(1, "S").source:sub(2)
local root = this:match("^(.*)/tests/") or "."
package.path = root .. "/lua/?.lua;" .. package.path

local cases = {}
local REQUIRED = {
  "esc_aborts_zero_change",
  "empty_input_aborts",
  "error_notifies_error_level",
  "error_paints_failure_marker",
  "sync_raise_clears_busy",
  "busy_second_submit_queues",
  "busy_race_second_submit_queues",
  "queued_pending_indicator",
  "sequential_second_starts_after_first",
  "cancel_running_keeps_partial",
  "cancel_all_drains_zero_change",
  "undo_block_per_job",
  "continuation_body_only_under_header",
  "continuation_signature_stripped_header_untouched",
  "continuation_request_word_trigger",
  "generate_mode_unfiltered",
  "continuation_indent_tabs",
  "continuation_filter_fast_event_safe",
  "digest_passed_to_generate",
}
local function case(name, fn)
  cases[#cases + 1] = { name = name, fn = fn }
end

-- Shared harness: fresh ui module state (resets the queue-backed runner), a
-- scratch buffer with the cursor at 0-indexed row 1, stream.create
-- spied on the REAL stream.lua (real extmark behavior is needed for the
-- failure-marker case), client.generate fully stubbed (zero network), and a
-- prompt-contract vim.ui.input stub that MOVES the cursor before submit
-- (async input UI simulation) plus a captured vim.notify.
local function fresh_env(scripted_input, fire_in_generate)
  local env = {}
  env.scripted_input = scripted_input
  env.notify_log = {}
  env.input_calls = 0
  env.generate_calls = 0
  env.create_calls = 0
  env.cancel_calls = 0
  env.create_row = nil
  env.job = nil
  env.captured_opts = nil

  env.buf = vim.api.nvim_create_buf(false, true)
  vim.api.nvim_set_current_buf(env.buf)
  env.original_lines = { "local x = 1", "local y = 2", "local z = 3" }
  vim.api.nvim_buf_set_lines(env.buf, 0, -1, false, env.original_lines)
  vim.api.nvim_win_set_cursor(0, { 2, 0 })  -- 1-indexed row 2 = 0-indexed row 1
  env.tick = vim.api.nvim_buf_get_changedtick(env.buf)

  env.config = {
    model = "m",
    api_key_env = "TEST_UI_KEY",
    curl_bin = "/bin/curl",
    budgets = { max_output_tokens = 100, context_tokens = 1000 },
  }
  vim.env.TEST_UI_KEY = "sk-ui-TEST"

  env.real_stream = require("vim_module.stream")
  env.real_create = env.real_stream.create
  env.real_stream.create = function(buf, row, opts)
    env.create_calls = env.create_calls + 1
    env.create_row = row
    env.job = env.real_create(buf, row, opts)
    return env.job
  end

  env.real_client = package.loaded["vim_module.client"]
  package.loaded["vim_module.client"] = {
    generate = function(opts)
      env.generate_calls = env.generate_calls + 1
      env.captured_opts = opts
      if fire_in_generate then fire_in_generate(opts) end
      return { cancel = function() env.cancel_calls = (env.cancel_calls or 0) + 1 end }
    end,
  }

  env.real_input = vim.ui.input
  vim.ui.input = function(opts, cb)
    env.input_calls = env.input_calls + 1
    assert(type(opts.prompt) == "string" and #opts.prompt > 0, "prompt must be a non-empty string")
    vim.api.nvim_win_set_cursor(0, { 3, 0 })
    cb(env.scripted_input)
  end

  env.real_notify = vim.notify
  vim.notify = function(msg, level)
    env.notify_log[#env.notify_log + 1] = { msg = msg, level = level }
  end

  -- Capture the queue instance the ui module builds at load time, so cases
  -- can assert job terminal statuses via env.queue:get(id).
  env.real_queue_mod = require("vim_module.queue")
  env.real_queue_new = env.real_queue_mod.new
  env.real_queue_mod.new = function(opts)
    env.queue = env.real_queue_new(opts)
    return env.queue
  end

  package.loaded["vim_module.ui"] = nil
  env.ui = require("vim_module.ui")
  return env
end

local function restore_env(env)
  vim.ui.input = env.real_input
  vim.notify = env.real_notify
  env.real_stream.create = env.real_create
  env.real_queue_mod.new = env.real_queue_new
  package.loaded["vim_module.client"] = env.real_client
end

local function assert_unchanged(env, name)
  assert(env.create_calls == 0, name .. ": stream.create must not be called")
  assert(env.generate_calls == 0, name .. ": client.generate must not be called")
  local lines = vim.api.nvim_buf_get_lines(env.buf, 0, -1, false)
  assert(#lines == #env.original_lines, name .. ": buffer line count must be unchanged")
  for i, want in ipairs(env.original_lines) do
    assert(lines[i] == want, name .. ": buffer line " .. i .. " must be unchanged")
  end
  assert(vim.api.nvim_buf_get_changedtick(env.buf) == env.tick, name .. ": changedtick must be unchanged")
end

case("esc_aborts_zero_change", function()
  local env = fresh_env(nil)  -- Esc: the input callback receives nil
  env.ui.start(env.config)
  assert_unchanged(env, "esc_aborts_zero_change")
  restore_env(env)
end)

case("empty_input_aborts", function()
  local env = fresh_env("")  -- Enter on empty input
  env.ui.start(env.config)
  assert_unchanged(env, "empty_input_aborts")
  restore_env(env)
end)

case("error_notifies_error_level", function()
  local env = fresh_env("do stuff", function(opts)
    opts.on_complete("boom")
  end)
  env.ui.start(env.config)
  vim.wait(1000, function() return #env.notify_log > 0 end)
  assert(#env.notify_log == 1, "error_notifies_error_level: expected exactly one notify, got " .. #env.notify_log)
  local n = env.notify_log[1]
  assert(type(n.msg) == "string" and n.msg:find("boom", 1, true),
    "error_notifies_error_level: notify msg must contain the API error")
  assert(n.level == vim.log.levels.ERROR, "error_notifies_error_level: notify level must be ERROR")
  restore_env(env)
end)

case("error_paints_failure_marker", function()
  local env = fresh_env("do stuff", function(opts)
    opts.on_complete("boom")
  end)
  env.ui.start(env.config)

  local function marker_present()
    local e = vim.api.nvim_buf_get_extmark_by_id(env.job.buf, env.job.ns, env.job.end_id, { details = true })
    return e and #e > 0 and e[3] and e[3].virt_text and e[3].virt_text[1]
      and type(e[3].virt_text[1][1]) == "string"
      and e[3].virt_text[1][1]:find("failed", 1, true) ~= nil
      and e[3].virt_text[1][2] == "ErrorMsg"
  end
  vim.wait(1000, marker_present, 10)
  assert(marker_present(), "error_paints_failure_marker: failure virt_text must be painted on the end mark")
  -- Settle-aware gate: stream.finish clears the status virt_text via its own
  -- scheduled flush — a marker painted BEFORE that flush would be wiped by it.
  -- Waiting lets the flush land; the marker must then STILL be there.
  vim.wait(50)
  assert(marker_present(), "error_paints_failure_marker: failure marker must survive the finish flush (settle-aware)")

  local err_notify = false
  for _, n in ipairs(env.notify_log) do
    if n.level == vim.log.levels.ERROR and type(n.msg) == "string" and n.msg:find("boom", 1, true) then
      err_notify = true
    end
  end
  assert(err_notify, "error_paints_failure_marker: ERROR notify must fire")

  -- GEN-01 anchor capture: the input stub moved the cursor to 0-indexed row 2
  -- before submitting, so re-reading the cursor inside the input callback
  -- would produce row 2 and fail these assertions.
  assert(env.create_row == 1,
    "error_paints_failure_marker: stream.create must anchor at the captured pre-prompt row (got " .. tostring(env.create_row) .. ")")
  assert(env.captured_opts and env.captured_opts.row == 1,
    "error_paints_failure_marker: client.generate must receive the captured pre-prompt row (got " .. tostring(env.captured_opts and env.captured_opts.row) .. ")")
  restore_env(env)
end)

case("busy_second_submit_queues", function()
  -- SEMANTIC BREAK (Phase 4 vs Phase 3): Phase 3 REFUSED the second job
  -- while busy; Phase 4 QUEUES it. Migrated in place from the Phase 3
  -- second-job-refused case — assertions inverted to queueing semantics,
  -- still fail-able against BOTH
  -- regressions: a return to refusal (prompt-open / WARN assertions) and a
  -- concurrent double-run (generate_calls assertion).
  local env = fresh_env("first")  -- generate stub does NOT fire on_complete: job stays in flight
  env.ui.start(env.config)
  assert(env.generate_calls == 1, "busy_second_submit_queues: first job must start")
  assert(env.input_calls == 1, "busy_second_submit_queues: prompt must open once")

  env.scripted_input = "second"
  env.ui.start(env.config)
  assert(env.input_calls == 2,
    "busy_second_submit_queues: prompt must open even while busy (queueing, not refusal)")
  assert(env.generate_calls == 1,
    "busy_second_submit_queues: second must NOT start while first runs")
  assert(env.create_calls == 2,
    "busy_second_submit_queues: queued anchor must exist (job not dropped)")
  local job2 = env.job
  local e2 = vim.api.nvim_buf_get_extmark_by_id(job2.buf, job2.ns, job2.end_id, { details = true })
  assert(e2 and #e2 > 0 and e2[3] and e2[3].virt_text and e2[3].virt_text[1]
    and type(e2[3].virt_text[1][1]) == "string"
    and e2[3].virt_text[1][1]:find("Queued", 1, true) ~= nil,
    "busy_second_submit_queues: queued anchor must show the Queued pending indicator")

  for _, n in ipairs(env.notify_log) do
    assert(not (type(n.msg) == "string" and n.msg:find("already generating", 1, true)),
      "busy_second_submit_queues: queueing must not notify 'already generating'")
  end

  -- Complete the FIRST job: the queued second must start after it and
  -- repaint its anchor to Generating.
  env.captured_opts.on_complete(nil)
  vim.wait(1000, function() return env.generate_calls == 2 end, 10)
  assert(env.generate_calls == 2,
    "busy_second_submit_queues: second must start after the first completes")
  local function job2_generating()
    local e = vim.api.nvim_buf_get_extmark_by_id(job2.buf, job2.ns, job2.end_id, { details = true })
    return e and #e > 0 and e[3] and e[3].virt_text and e[3].virt_text[1]
      and type(e[3].virt_text[1][1]) == "string"
      and e[3].virt_text[1][1]:find("Generating", 1, true) ~= nil
  end
  vim.wait(1000, job2_generating, 10)
  assert(job2_generating(),
    "busy_second_submit_queues: second stream job must repaint to Generating")

  -- Release the second job at the end of the case.
  env.captured_opts.on_complete(nil)
  vim.wait(50)
  restore_env(env)
end)

case("sync_raise_clears_busy", function()
  -- WR-02: client.generate can raise synchronously (temp-write failure,
  -- encode failure, spawn throw). The raise must not strand busy == true,
  -- and must surface as an ERROR notify.
  local raised = false
  local env = fresh_env("do stuff", function()
    if not raised then
      raised = true
      error("boom-sync")
    end
  end)
  env.ui.start(env.config)
  vim.wait(1000, function() return #env.notify_log > 0 end)
  local notified = false
  for _, n in ipairs(env.notify_log) do
    if n.level == vim.log.levels.ERROR and type(n.msg) == "string" and n.msg:find("boom-sync", 1, true) then
      notified = true
    end
  end
  assert(notified, "sync_raise_clears_busy: ERROR notify must carry the raise message")

  -- busy must have been cleared by the raise path: a second start is accepted.
  env.scripted_input = "again"
  env.ui.start(env.config)
  assert(env.generate_calls == 2,
    "sync_raise_clears_busy: busy flag must be cleared after the raise (generate_calls=" .. env.generate_calls .. ")")
  for _, n in ipairs(env.notify_log) do
    assert(not (type(n.msg) == "string" and n.msg:find("already generating", 1, true)),
      "sync_raise_clears_busy: second start must not hit the busy guard")
  end

  -- Release the second job at the end of the case.
  env.captured_opts.on_complete(nil)
  vim.wait(50)
  restore_env(env)
end)

case("busy_race_second_submit_queues", function()
  -- WR-03 race structure KEPT: async-UI race — BOTH prompts open before
  -- either submits (the entry guard cannot see the un-submitted first job).
  -- SEMANTIC BREAK (Phase 4 vs Phase 3): the second submit now QUEUES — it
  -- was refused in Phase 3 (the Phase 3 race case refused it). Migrated in
  -- place — fail-able against BOTH regressions: a return to refusal (create/WARN
  -- assertions) and a concurrent double-run (generate_calls assertion).
  local env = fresh_env("first")  -- generate stub does NOT fire on_complete
  local pending = {}
  vim.ui.input = function(opts, cb)
    env.input_calls = env.input_calls + 1
    pending[#pending + 1] = cb
  end
  env.ui.start(env.config)
  env.ui.start(env.config)
  assert(#pending == 2, "busy_race_second_submit_queues: both prompts must open before either submits")

  pending[1]("first")  -- first submit runs immediately
  assert(env.generate_calls == 1, "busy_race_second_submit_queues: first submit must generate")

  pending[2]("second")  -- second submit arrives while busy: QUEUES
  assert(env.generate_calls == 1,
    "busy_race_second_submit_queues: second submit must NOT start while first runs, got generate_calls=" .. env.generate_calls)
  assert(env.create_calls == 2,
    "busy_race_second_submit_queues: second submit must create a queued stream region, got create_calls=" .. env.create_calls)

  for _, n in ipairs(env.notify_log) do
    assert(not (type(n.msg) == "string" and n.msg:find("already generating", 1, true)),
      "busy_race_second_submit_queues: queueing must not notify 'already generating'")
  end

  -- Complete the first job: the queued second must run.
  env.captured_opts.on_complete(nil)
  vim.wait(1000, function() return env.generate_calls == 2 end, 10)
  assert(env.generate_calls == 2,
    "busy_race_second_submit_queues: second must run after the first completes")

  -- Release the second job at the end of the case.
  env.captured_opts.on_complete(nil)
  vim.wait(50)
  restore_env(env)
end)

case("queued_pending_indicator", function()
  -- QUEUE-01 pending indicator: the queued anchor paints "Queued" until its
  -- turn, then repaints "Generating". Case tail holds the third-submit
  -- queueing assertion (NOT in sync_raise_clears_busy).
  local env = fresh_env("one")
  env.ui.start(env.config)
  local job1 = env.job
  env.scripted_input = "two"
  env.ui.start(env.config)
  local job2 = env.job
  assert(env.generate_calls == 1, "queued_pending_indicator: only the first job runs")
  assert(env.create_calls == 2, "queued_pending_indicator: two anchors must exist")

  local function vtext(job)
    local e = vim.api.nvim_buf_get_extmark_by_id(job.buf, job.ns, job.end_id, { details = true })
    if e and #e > 0 and e[3] and e[3].virt_text and e[3].virt_text[1] then
      return e[3].virt_text[1][1], e[3].virt_text[1][2]
    end
    return nil, nil
  end
  vim.wait(1000, function()
    local t1, t2 = vtext(job1), vtext(job2)
    return t1 and t1:find("Generating", 1, true) and t2 and t2:find("Queued", 1, true)
  end, 10)
  local t1, h1 = vtext(job1)
  local t2, h2 = vtext(job2)
  assert(t1 and t1:find("Generating", 1, true),
    "queued_pending_indicator: first end mark must show Generating")
  assert(h1 == "Comment", "queued_pending_indicator: Generating painted with Comment hl")
  assert(t2 and t2:find("Queued", 1, true),
    "queued_pending_indicator: second end mark must show the Queued pending indicator")
  assert(h2 == "Comment", "queued_pending_indicator: Queued painted with Comment hl")

  -- Complete the first: the second repaints to Generating.
  env.captured_opts.on_complete(nil)
  vim.wait(1000, function()
    local t = vtext(job2)
    return env.generate_calls == 2 and t and t:find("Generating", 1, true)
  end, 10)
  assert(env.generate_calls == 2, "queued_pending_indicator: second starts after first completes")
  local t2b = vtext(job2)
  assert(t2b and t2b:find("Generating", 1, true),
    "queued_pending_indicator: second end mark must repaint to Generating")

  -- THIRD submit while the second runs: prompt opens, third queues.
  env.scripted_input = "three"
  env.ui.start(env.config)
  local job3 = env.job
  assert(env.input_calls == 3, "queued_pending_indicator: third prompt must open")
  assert(env.generate_calls == 2, "queued_pending_indicator: third must NOT start while second runs")
  local t3 = vtext(job3)
  assert(t3 and t3:find("Queued", 1, true),
    "queued_pending_indicator: third end mark must show the Queued pending indicator")

  -- Complete the second: the third starts and repaints Generating.
  env.captured_opts.on_complete(nil)
  vim.wait(1000, function() return env.generate_calls == 3 end, 10)
  assert(env.generate_calls == 3, "queued_pending_indicator: third starts after second completes")
  vim.wait(1000, function()
    local t = vtext(job3)
    return t and t:find("Generating", 1, true)
  end, 10)
  local t3b = vtext(job3)
  assert(t3b and t3b:find("Generating", 1, true),
    "queued_pending_indicator: third end mark must repaint to Generating")

  -- Release the third job at the end of the case.
  env.captured_opts.on_complete(nil)
  vim.wait(50)
  restore_env(env)
end)

case("sequential_second_starts_after_first", function()
  -- QUEUE-01 strict sequencing: red on any overlap of two generations.
  local env = fresh_env("one")
  env.ui.start(env.config)
  env.scripted_input = "two"
  env.ui.start(env.config)
  assert(env.generate_calls == 1, "sequential_second_starts_after_first: only first starts")
  vim.wait(50)
  assert(env.generate_calls == 1,
    "sequential_second_starts_after_first: second must NOT start while first is in flight")
  env.captured_opts.on_complete(nil)
  vim.wait(1000, function() return env.generate_calls == 2 end, 10)
  assert(env.generate_calls == 2,
    "sequential_second_starts_after_first: second must start after first completes")
  env.captured_opts.on_complete(nil)
  vim.wait(50)
  restore_env(env)
end)

case("cancel_running_keeps_partial", function()
  -- GEN-05: cancelling the running job keeps its partial output; the job
  -- terminates "cancelled".
  local env = fresh_env("one")
  env.ui.start(env.config)
  assert(env.generate_calls == 1, "cancel_running_keeps_partial: job must start")
  env.captured_opts.on_lines({ "local a = 1" })
  vim.wait(1000, function()
    return vim.tbl_contains(vim.api.nvim_buf_get_lines(env.buf, 0, -1, false), "local a = 1")
  end, 10)

  env.ui.cancel()
  assert(env.cancel_calls == 1,
    "cancel_running_keeps_partial: handle.cancel must be observed, got cancel_calls=" .. tostring(env.cancel_calls))
  -- Simulate the real client: kill -> on_complete(nil).
  env.captured_opts.on_complete(nil)
  vim.wait(50)

  local lines = vim.api.nvim_buf_get_lines(env.buf, 0, -1, false)
  assert(vim.tbl_contains(lines, "local a = 1"),
    "cancel_running_keeps_partial: partial output must be kept (GEN-05)")
  assert(env.queue:get(1) and env.queue:get(1).status == "cancelled",
    "cancel_running_keeps_partial: job terminal status must be cancelled")
  restore_env(env)
end)

case("cancel_all_drains_zero_change", function()
  -- QUEUE-02 / T-04-12: cancel_all keeps the running job's partial but the
  -- drained queued job produces ZERO buffer change and clears its indicator.
  local env = fresh_env("one")
  env.ui.start(env.config)
  local job1 = env.job
  local opts1 = env.captured_opts
  env.scripted_input = "two"
  env.ui.start(env.config)
  local job2 = env.job
  assert(env.generate_calls == 1, "cancel_all_drains_zero_change: only first runs")
  assert(env.create_calls == 2, "cancel_all_drains_zero_change: two anchors must exist")

  opts1.on_lines({ "-- partial-one" })
  vim.wait(1000, function()
    return vim.tbl_contains(vim.api.nvim_buf_get_lines(env.buf, 0, -1, false), "-- partial-one")
  end, 10)
  local before = vim.api.nvim_buf_get_lines(env.buf, 0, -1, false)
  local tick = vim.api.nvim_buf_get_changedtick(env.buf)
  assert(#before == #env.original_lines + 1,
    "cancel_all_drains_zero_change: partial line must be the only insertion")

  env.ui.cancel_all()
  -- Simulate the real client: the running job's kill -> on_complete(nil).
  opts1.on_complete(nil)
  vim.wait(100)

  local after = vim.api.nvim_buf_get_lines(env.buf, 0, -1, false)
  assert(vim.deep_equal(after, before),
    "cancel_all_drains_zero_change: buffer must be byte-identical after the drain")
  assert(vim.api.nvim_buf_get_changedtick(env.buf) == tick,
    "cancel_all_drains_zero_change: changedtick must not move (zero buffer change)")
  -- Exactly original lines + the first job's partial at its anchor (row 1).
  local expected = { env.original_lines[1], "-- partial-one", env.original_lines[2], env.original_lines[3] }
  assert(vim.deep_equal(after, expected),
    "cancel_all_drains_zero_change: buffer must be originals + first-job partial only")

  -- The drained job's end-mark virt_text must be cleared (no "Queued" left).
  local e2 = vim.api.nvim_buf_get_extmark_by_id(job2.buf, job2.ns, job2.end_id, { details = true })
  local has_queued = e2 and #e2 > 0 and e2[3] and e2[3].virt_text and e2[3].virt_text[1]
    and type(e2[3].virt_text[1][1]) == "string"
    and e2[3].virt_text[1][1]:find("Queued", 1, true) ~= nil
  assert(not has_queued,
    "cancel_all_drains_zero_change: drained job's Queued indicator must be cleared")
  assert(env.queue:get(1) and env.queue:get(1).status == "cancelled",
    "cancel_all_drains_zero_change: running job must terminate cancelled")
  assert(env.queue:get(2) and env.queue:get(2).status == "cancelled",
    "cancel_all_drains_zero_change: drained job must terminate cancelled")
  restore_env(env)
end)

case("undo_block_per_job", function()
  -- QUEUE-02 undo independence: one generation = one undo block; a single
  -- `u` must remove ONLY the second job's lines. Red in BOTH directions —
  -- joined blocks eat the first job's lines; split blocks leave j2-b behind.
  local env = fresh_env("job-one")
  env.ui.start(env.config)
  local opts1 = env.captured_opts
  opts1.on_lines({ "-- j1-a" })
  vim.wait(50)  -- land as its own flush so the next append exercises undojoin
  opts1.on_lines({ "-- j1-b" })
  vim.wait(50)
  opts1.on_complete(nil)
  vim.wait(50)

  env.scripted_input = "job-two"
  env.ui.start(env.config)
  local opts2 = env.captured_opts
  opts2.on_lines({ "-- j2-a" })
  vim.wait(50)
  opts2.on_lines({ "-- j2-b" })
  vim.wait(50)
  opts2.on_complete(nil)
  vim.wait(50)

  local all = vim.api.nvim_buf_get_lines(env.buf, 0, -1, false)
  assert(vim.tbl_contains(all, "-- j1-a") and vim.tbl_contains(all, "-- j1-b"),
    "undo_block_per_job: first job lines must be present")
  assert(vim.tbl_contains(all, "-- j2-a") and vim.tbl_contains(all, "-- j2-b"),
    "undo_block_per_job: second job lines must be present")

  vim.cmd("normal! u")
  local after = vim.api.nvim_buf_get_lines(env.buf, 0, -1, false)
  assert(vim.tbl_contains(after, "-- j1-a") and vim.tbl_contains(after, "-- j1-b"),
    "undo_block_per_job: a single u must NOT remove the first job's lines")
  assert(not vim.tbl_contains(after, "-- j2-a") and not vim.tbl_contains(after, "-- j2-b"),
    "undo_block_per_job: a single u must remove BOTH second-job lines")
  for _, want in ipairs(env.original_lines) do
    assert(vim.tbl_contains(after, want),
      "undo_block_per_job: original lines must survive the undo")
  end
  restore_env(env)
end)

-- CONT-01 + CTX-02 continuation/digest cases -----------------------------

-- Helper: override vim.ui.input to avoid cursor out-of-range on short
-- buffers (the harness stub moves the cursor to row 3 for GEN-01 testing;
-- continuation buffers may be shorter).
local function safe_input(env)
  vim.ui.input = function(opts, cb)
    env.input_calls = env.input_calls + 1
    cb(env.scripted_input)
  end
end

-- Helper: stub context.get_digest, returns restore function.
local function stub_digest(value)
  local real = package.loaded["vim_module.context"]
  package.loaded["vim_module.context"] = { get_digest = function() return value end }
  return function() package.loaded["vim_module.context"] = real end
end

case("continuation_body_only_under_header", function()
  local restore_ctx = stub_digest("DIGEST-SENTINEL")
  local env = fresh_env("write the rest", function(opts)
    opts.on_lines({ "return n" })
    opts.on_complete(nil)
  end)
  vim.api.nvim_buf_set_lines(env.buf, 0, -1, false, { "def fib(n):", "x = 1" })
  vim.api.nvim_win_set_cursor(0, { 1, 0 })  -- row 0 = header
  vim.bo[env.buf].expandtab = true
  vim.bo[env.buf].shiftwidth = 4
  safe_input(env)
  env.ui.start(env.config)
  vim.wait(1000, function()
    local l = vim.api.nvim_buf_get_lines(env.buf, 0, -1, false)
    return #l == 3 and l[2] == "    return n"
  end, 10)
  local lines = vim.api.nvim_buf_get_lines(env.buf, 0, -1, false)
  assert(vim.deep_equal(lines, { "def fib(n):", "    return n", "x = 1" }),
    "continuation_body_only_under_header: expected body under header, got " .. vim.inspect(lines))
  assert(env.create_row == 1,
    "continuation_body_only_under_header: stream.create must anchor at header+1 (got " .. tostring(env.create_row) .. ")")
  assert(env.captured_opts and env.captured_opts.row == 0,
    "continuation_body_only_under_header: generate must receive the header row (got " .. tostring(env.captured_opts and env.captured_opts.row) .. ")")
  assert(env.captured_opts and env.captured_opts.mode == "continuation",
    "continuation_body_only_under_header: mode must be continuation")
  restore_ctx()
  restore_env(env)
end)

case("continuation_signature_stripped_header_untouched", function()
  local restore_ctx = stub_digest("DIGEST-SENTINEL")
  local env = fresh_env("write the rest", function(opts)
    opts.on_lines({ "def fib(n):", "return n", "  def fib(n):  " })
    opts.on_complete(nil)
  end)
  vim.api.nvim_buf_set_lines(env.buf, 0, -1, false, { "def fib(n):", "x = 1" })
  vim.api.nvim_win_set_cursor(0, { 1, 0 })
  vim.bo[env.buf].expandtab = true
  vim.bo[env.buf].shiftwidth = 4
  safe_input(env)
  env.ui.start(env.config)
  vim.wait(1000, function()
    local l = vim.api.nvim_buf_get_lines(env.buf, 0, -1, false)
    return #l == 3 and l[2] == "    return n"
  end, 10)
  local lines = vim.api.nvim_buf_get_lines(env.buf, 0, -1, false)
  assert(vim.deep_equal(lines, { "def fib(n):", "    return n", "x = 1" }),
    "continuation_signature_stripped_header_untouched: signatures must be stripped, header untouched, got " .. vim.inspect(lines))
  assert(lines[1] == "def fib(n):",
    "continuation_signature_stripped_header_untouched: header must be byte-identical")
  restore_ctx()
  restore_env(env)
end)

case("continuation_request_word_trigger", function()
  local restore_ctx = stub_digest("DIGEST-SENTINEL")
  local env = fresh_env("finish this", function(opts)
    opts.on_complete(nil)
  end)
  vim.api.nvim_buf_set_lines(env.buf, 0, -1, false, { "x = 1", "y = 2" })
  vim.api.nvim_win_set_cursor(0, { 1, 0 })  -- row 0, anchor "x = 1" (NOT a header)
  safe_input(env)
  env.ui.start(env.config)
  assert(env.captured_opts and env.captured_opts.mode == "continuation",
    "continuation_request_word_trigger: request word 'finish' must trigger continuation")
  assert(env.create_row == 1,
    "continuation_request_word_trigger: create_row must be row+1 (got " .. tostring(env.create_row) .. ")")
  restore_ctx()
  restore_env(env)
end)

case("generate_mode_unfiltered", function()
  local restore_ctx = stub_digest("DIGEST-SENTINEL")
  local env = fresh_env("write a function", function(opts)
    opts.on_lines({ "local q = 1" })
    opts.on_complete(nil)
  end)
  vim.api.nvim_buf_set_lines(env.buf, 0, -1, false, { "x = 1", "y = 2" })
  vim.api.nvim_win_set_cursor(0, { 1, 0 })  -- row 0, anchor "x = 1" (NOT a header)
  safe_input(env)
  env.ui.start(env.config)
  vim.wait(1000, function()
    return vim.tbl_contains(vim.api.nvim_buf_get_lines(env.buf, 0, -1, false), "local q = 1")
  end, 10)
  assert(env.captured_opts and env.captured_opts.mode == nil,
    "generate_mode_unfiltered: mode must be nil for generate (got " .. tostring(env.captured_opts and env.captured_opts.mode) .. ")")
  assert(env.create_row == 0,
    "generate_mode_unfiltered: create_row must equal row (no offset), got " .. tostring(env.create_row))
  local lines = vim.api.nvim_buf_get_lines(env.buf, 0, -1, false)
  assert(vim.tbl_contains(lines, "local q = 1"),
    "generate_mode_unfiltered: on_lines must pass through verbatim (unindented)")
  restore_ctx()
  restore_env(env)
end)

case("continuation_indent_tabs", function()
  local restore_ctx = stub_digest("DIGEST-SENTINEL")
  local env = fresh_env("fill body", function(opts)
    opts.on_lines({ "return 1", "    x = 2" })
    opts.on_complete(nil)
  end)
  vim.api.nvim_buf_set_lines(env.buf, 0, -1, false, { "def f():", "pass" })
  vim.api.nvim_win_set_cursor(0, { 1, 0 })
  vim.bo[env.buf].expandtab = false
  vim.bo[env.buf].shiftwidth = 4
  vim.bo[env.buf].tabstop = 8
  safe_input(env)
  env.ui.start(env.config)
  vim.wait(1000, function()
    local l = vim.api.nvim_buf_get_lines(env.buf, 0, -1, false)
    return #l == 4
  end, 10)
  local lines = vim.api.nvim_buf_get_lines(env.buf, 0, -1, false)
  assert(lines[2] == "\treturn 1",
    "continuation_indent_tabs: first body line must be one tab + 'return 1', got " .. vim.inspect(lines[2]))
  assert(lines[3] == "\t\tx = 2",
    "continuation_indent_tabs: nested line must be two tabs + 'x = 2', got " .. vim.inspect(lines[3]))
  restore_ctx()
  restore_env(env)
end)

case("continuation_filter_fast_event_safe", function()
  -- CR-01: in production on_lines runs inside a vim.system stdout callback
  -- (fast event). The continuation filter must use only captured state there —
  -- a vim.bo read at feed time raises E5560 and the body never lands.
  local restore_ctx = stub_digest("DIGEST-SENTINEL")
  local env = fresh_env("write the rest", function() end)
  vim.api.nvim_buf_set_lines(env.buf, 0, -1, false, { "def fib(n):", "x = 1" })
  vim.api.nvim_win_set_cursor(0, { 1, 0 })
  vim.bo[env.buf].expandtab = true
  vim.bo[env.buf].shiftwidth = 4
  safe_input(env)
  env.ui.start(env.config)
  local opts1 = env.captured_opts
  assert(opts1 and opts1.mode == "continuation",
    "continuation_filter_fast_event_safe: mode must be continuation")
  -- Drive on_lines from a REAL vim.system stdout callback — the production
  -- fast-event path (same shape as the client's SSE feed).
  local fired = false
  local saw_fast = false
  vim.system({ "printf", "x" }, {
    stdout = function(_, data)
      if data and not fired then
        fired = true
        saw_fast = vim.in_fast_event()
        opts1.on_lines({ "return n" })
      end
    end,
  }, function() end)
  vim.wait(2000, function()
    local l = vim.api.nvim_buf_get_lines(env.buf, 0, -1, false)
    return #l == 3 and l[2] == "    return n"
  end, 10)
  assert(saw_fast,
    "continuation_filter_fast_event_safe: stdout callback must run in a fast event for this case to prove anything")
  local lines = vim.api.nvim_buf_get_lines(env.buf, 0, -1, false)
  assert(vim.deep_equal(lines, { "def fib(n):", "    return n", "x = 1" }),
    "continuation_filter_fast_event_safe: body must land from a fast-event on_lines (E5560 regression), got " .. vim.inspect(lines))
  opts1.on_complete(nil)
  vim.wait(50)
  restore_ctx()
  restore_env(env)
end)

case("digest_passed_to_generate", function()
  local restore_ctx = stub_digest("DIGEST-SENTINEL")
  local env = fresh_env("do stuff", function(opts)
    opts.on_complete(nil)
  end)
  env.ui.start(env.config)
  local opts1 = env.captured_opts
  assert(opts1 and opts1.digest == "DIGEST-SENTINEL",
    "digest_passed_to_generate: digest must be passed through (got " .. tostring(opts1 and opts1.digest) .. ")")
  vim.wait(100)

  -- Stub returns nil: digest must be nil in opts.
  restore_ctx()
  restore_ctx = stub_digest(nil)
  env.scripted_input = "more stuff"
  env.ui.start(env.config)
  local opts2 = env.captured_opts
  assert(opts2 and opts2.digest == nil,
    "digest_passed_to_generate: nil digest must pass through as nil (got " .. tostring(opts2 and opts2.digest) .. ")")
  vim.wait(50)

  restore_ctx()
  restore_env(env)
end)

local registered = {}
for _, c in ipairs(cases) do registered[c.name] = true end
for _, name in ipairs(REQUIRED) do
  if not registered[name] then
    error("ui_spec: required case missing: " .. name)
  end
end

local failures = {}
for _, c in ipairs(cases) do
  local ok, err = pcall(c.fn)
  if not ok then
    failures[#failures + 1] = c.name .. ": " .. tostring(err)
  end
end
if #failures > 0 then
  for _, f in ipairs(failures) do
    print("FAIL " .. f)
  end
  error("ui_spec: " .. #failures .. " case(s) failed: " .. table.concat(failures, "; "))
end
print("ui_spec: all " .. #cases .. " cases passed")
